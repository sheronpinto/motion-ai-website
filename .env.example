# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local dev: SQLite file, zero setup.
#   DATABASE_URL="file:./dev.db"
# Production: point this at a persistent managed Postgres instance instead
# (Railway / Supabase / Neon / RDS). Update prisma/schema.prisma's
# `provider` from "sqlite" to "postgresql" when you do.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# â”€â”€ Razorpay â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# From Dashboard â†’ Settings â†’ API Keys. Used server-side only, to call the
# Payment Links API for reconciliation/fallback lookups. NEVER sent to the
# browser.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Dashboard â†’ Settings â†’ Webhooks â†’ your webhook's secret (NOT the API key
# secret â€” a separate value you set when creating the webhook).
RAZORPAY_WEBHOOK_SECRET=

# The existing Payment Button to embed. Public â€” safe to expose.
NEXT_PUBLIC_RAZORPAY_PAYMENT_BUTTON_ID=pl_TSp0dDD3WZ4hn2

# â”€â”€ Product â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Price in paise (â‚¹500.00 = 50000). The backend is the only source of
# truth for this value â€” it re-checks every webhook/payment against it.
PRODUCT_PRICE_PAISE=50000
NEXT_PUBLIC_PRODUCT_VERSION=v1.0.0

# â”€â”€ Download authorization â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Random 32+ byte secret used to sign short-lived download tokens.
# Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_TOKEN_TTL_SECONDS=120

# â”€â”€ Download storage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# "local" reads the ZIP from disk (fine for a single-server deploy).
# "s3" streams a private object via a short-lived presigned URL â€” use this
# for Cloudflare R2, AWS S3, or any S3-compatible object store.
DOWNLOAD_STORAGE_PROVIDER=s3

# Used when DOWNLOAD_STORAGE_PROVIDER=local. Path is on the server's
# filesystem, outside the web root â€” never inside /public.
LOCAL_DOWNLOAD_PATH=/secure-files/motion-ai-win-x64.zip
LOCAL_DOWNLOAD_FILENAME=Motion-AI-Setup-v1.0.0-win-x64.zip

# Used when DOWNLOAD_STORAGE_PROVIDER=s3 (works for AWS S3 or any
# S3-compatible endpoint, e.g. Cloudflare R2).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_OBJECT_KEY=motion-ai-win-x64.zip

# â”€â”€ Site â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public base URL of this deployment, used to build the Razorpay callback
# URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
